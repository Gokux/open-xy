/* Retained drawing renderer for OP-XY 1.2.0, sized by the machine's declared
 * display (@PATHS@ paths of @POINTS@ points, @NODES@ nodes, @PALETTE@ palette entries).
 * @OBJECT_BYTES@-byte renderer object: stock helper 0..75, node pointers @NODES_AT@,
 * palette IDs @PALETTE_AT@, frame delta @DELTA_AT@, validated path geometry @GEOMETRY_AT@
 * and applied path keys @KEYS_AT@. Display state, input and frame are typed C++ storage.
 */
.section .text
.align 2
.global @PREFIX@_screen_ctor
.type @PREFIX@_screen_ctor, STT_FUNC
@PREFIX@_screen_ctor:
    /* Range check only; the slot must also be empty or ours (below). */
    R2 = 1;
    CC = R1 < R2 (IU);
    IF CC JUMP .Lscreen_invalid_id;
    R2 = @PAGE_LIMIT@;
    CC = R1 < R2 (IU);
    IF !CC JUMP .Lscreen_invalid_id;
    LINK 0;
    [--SP] = (R7:4, P5:3);
    SP += -12;
    P5 = R0;
    R2.H = @PREFIX@_screen_asset;
    R2.L = @PREFIX@_screen_asset;
    P0 = 0x8d51fc7c;
    CALL (P0);
    R0.H = @PREFIX@_screen_vtable;
    R0.L = @PREFIX@_screen_vtable;
    [P5] = R0;
    R0 = P5;
    SP += 12;
    (R7:4, P5:3) = [SP++];
    UNLINK;
    RTS;
.Lscreen_invalid_id:
    R0 = 0;
    RTS;
.size @PREFIX@_screen_ctor, .-@PREFIX@_screen_ctor

.global @PREFIX@_screen_init
.type @PREFIX@_screen_init, STT_FUNC
@PREFIX@_screen_init:
    LINK 0;
    [--SP] = (R7:4, P5:3);
    SP += -12;
    P5 = R0;
    P0 = P5;
    P0 += 60;
    P0 += 16;
    R0 = 0;
    R2 = @ZERO_WORDS@;
.Lscreen_init_zero:
    [P0++] = R0;
    R2 += -1;
    CC = R2 == 0;
    IF !CC JUMP .Lscreen_init_zero;
    R0.H = @PREFIX@_display_state;
    R0.L = @PREFIX@_display_state;
    R1.H = @PREFIX@_display_frame;
    R1.L = @PREFIX@_display_frame;
    CALL _@PREFIX@_display_reset;
    R0 = [P5 + 8];
    CC = R0 == 0;
    IF CC JUMP .Lscreen_init_done;
    R0 = P5;
    R0 += 24;
    R1 = P5;
    R2 = 0;
    P0 = 0x8d520b3c;
    CALL (P0);
    P3.H = @PREFIX@_draw_ids;
    P3.L = @PREFIX@_draw_ids;
    P4 = P5;
    P4 += 60;
    P4 += 16;
    R6 = @NODES@;
.Lscreen_init_nodes:
    R0 = P5;
    R1 = [P3++];
    R2 = 1;
    P0 = 0x8d51f740;
    CALL (P0);
    CALL @PREFIX@_draw_path_node;
    [P4++] = R0;
    R6 += -1;
    CC = R6 == 0;
    IF !CC JUMP .Lscreen_init_nodes;
    /* P4 now points at the palette IDs: same-renderer typed donors. */
    R6 = @PALETTE@;
.Lscreen_init_palette:
    R0 = P5;
    R1 = [P3++];
    R2 = 1;
    P0 = 0x8d51f740;
    CALL (P0);
    R1 = [P5 + 8];
    CALL @PREFIX@_draw_palette_ids;
    [P4++] = R0;
    R6 += -1;
    CC = R6 == 0;
    IF !CC JUMP .Lscreen_init_palette;
    /* Paths are the first nodes; record each one's validated geometry. */
@GEOMETRY_INIT@
.Lscreen_init_done:
    SP += 12;
    (R7:4, P5:3) = [SP++];
    UNLINK;
    RTS;
.size @PREFIX@_screen_init, .-@PREFIX@_screen_init

.global @PREFIX@_screen_frame
.type @PREFIX@_screen_frame, STT_FUNC
@PREFIX@_screen_frame:
    LINK 0;
    [--SP] = (R7:4, P5:3);
    SP += -12;
    P5 = R0;
    /* Incoming R1 is dispatcher elapsed time in Q10 seconds. */
    [P5 + @DELTA_AT@] = R1;
    R0 = [P5 + 8];
    CC = R0 == 0;
    IF CC JUMP .Lscreen_frame_done;
    /* All four value and title pointers must exist before generic update. */
    P0 = P5;
    P0 += 24;
    R2 = 8;
.Lscreen_binding_check:
    R0 = [P0++];
    CC = R0 == 0;
    IF CC JUMP .Lscreen_frame_done;
    R2 += -1;
    CC = R2 == 0;
    IF !CC JUMP .Lscreen_binding_check;
    P0 = 0x8d4d78cc;
    CALL (P0);
    R7 = R0;
    P0 = 0x8d4d7c60;
    CALL (P0);
    P4 = R0;
    R2 = R0;
    R1 = R7;
    R0 = P5;
    R0 += 24;
    P0 = 0x8d545ae4;
    CALL (P0);

    R0 = P5;
    R1 = P4;
    R2 = R7;
    CALL @PREFIX@_screen_animate;

    /* Stock helper updates all four titles and normalized percentage values.
     * Physical mappings remain in the DSP contract; no waveform-selector override. */
    R0 = P5;
    R1 = 0;
    P0 = 0x8d51f254;
    CALL (P0);
.Lscreen_frame_done:
    SP += 12;
    (R7:4, P5:3) = [SP++];
    UNLINK;
    RTS;
.size @PREFIX@_screen_frame, .-@PREFIX@_screen_frame

.global @PREFIX@_screen_destroy
.type @PREFIX@_screen_destroy, STT_FUNC
@PREFIX@_screen_destroy:
    LINK 0;
    [--SP] = (R7:4, P5:3);
    SP += -12;
    P5 = R0;
    P0 = 0x8d51f1f0;
    CALL (P0);
    R0 = 0;
    [P5 + 16] = R0;
    P0 = P5;
    P0 += 60;
    P0 += 16;
    R2 = @ZERO_WORDS@;
.Lscreen_destroy_zero:
    [P0++] = R0;
    R2 += -1;
    CC = R2 == 0;
    IF !CC JUMP .Lscreen_destroy_zero;
    SP += 12;
    (R7:4, P5:3) = [SP++];
    UNLINK;
    RTS;
.size @PREFIX@_screen_destroy, .-@PREFIX@_screen_destroy

/* R0=node ->same pointer or0. Only source-bound path leaves accepted. */
.type @PREFIX@_draw_path_node, STT_FUNC
@PREFIX@_draw_path_node:
    CC = R0 == 0;
    IF CC JUMP .Lpath_bad;
    P0 = R0;
    R2 = [P0];
    R3 = 0x840c1a40;
    CC = R2 == R3;
    IF !CC JUMP .Lpath_bad;
    RTS;
.Lpath_bad:
    R0 = 0;
    RTS;
.size @PREFIX@_draw_path_node, .-@PREFIX@_draw_path_node

/* R0=donor,R1=ownSVG ->packed positive fill/stroke IDs or0.
 * Vtable and both own renderer vector bounds checked before caching IDs.
 * Does not mutate palette records, node ownership or vector metadata. */
.type @PREFIX@_draw_palette_ids, STT_FUNC
@PREFIX@_draw_palette_ids:
    LINK 0;
    [--SP] = (R7:4, P5:3);
    SP += -12;
    P5 = R1;
    CALL @PREFIX@_draw_path_node;
    CC = R0 == 0;
    IF CC JUMP .Lpalette_bad;
    P0 = R0;
    R4 = W[P0 + 112] (X);
    R5 = W[P0 + 114] (Z);
    CC = R4 <= 0;
    IF CC JUMP .Lpalette_bad;
    CC = R5 == 0;
    IF CC JUMP .Lpalette_bad;
    R0 = [P5 + 100];
    R1 = [P5 + 104];
    R2 = [P5 + 108];
    CC = R0 == 0;
    IF CC JUMP .Lpalette_bad;
    CC = R1 < R0 (IU);
    IF CC JUMP .Lpalette_bad;
    CC = R2 < R1 (IU);
    IF CC JUMP .Lpalette_bad;
    R1 = R1 - R0 (NS);
    R2 = R4;
    R2 <<= 2;
    CC = R1 < R2 (IU);
    IF CC JUMP .Lpalette_bad;
    R0 = [P5 + 132];
    R1 = [P5 + 136];
    R2 = [P5 + 140];
    CC = R0 == 0;
    IF CC JUMP .Lpalette_bad;
    CC = R1 < R0 (IU);
    IF CC JUMP .Lpalette_bad;
    CC = R2 < R1 (IU);
    IF CC JUMP .Lpalette_bad;
    R1 = R1 - R0 (NS);
    R2 = R5;
    R3 = 20;
    R2 *= R3;
    CC = R1 < R2 (IU);
    IF CC JUMP .Lpalette_bad;
    R5 <<= 16;
    R0 = R4 + R5 (NS);
    JUMP .Lpalette_done;
.Lpalette_bad:
    R0 = 0;
.Lpalette_done:
    SP += 12;
    (R7:4, P5:3) = [SP++];
    UNLINK;
    RTS;
.size @PREFIX@_draw_palette_ids, .-@PREFIX@_draw_palette_ids

/* R0=path ->begin or 0; command vector exactly M, (@POINTS@-1) L, Z (32 bytes each).
 * Check ordered aligned bounds; only coordinates are later changed.
 * Preserves callee saves; no calls, allocations or writes. */
.type @PREFIX@_draw_geometry, STT_FUNC
@PREFIX@_draw_geometry:
    CC = R0 == 0;
    IF CC JUMP .Lgeometry_bad;
    P0 = R0;
    R1 = [P0];
    R2 = 0x840c1a40;
    CC = R1 == R2;
    IF !CC JUMP .Lgeometry_bad;
    R0 = [P0 + 120];
    R1 = [P0 + 124];
    R2 = [P0 + 128];
    CC = R0 == 0;
    IF CC JUMP .Lgeometry_bad;
    R3 = R0;
    R3 <<= 30;
    CC = R3 == 0;
    IF !CC JUMP .Lgeometry_bad;
    CC = R1 < R0 (IU);
    IF CC JUMP .Lgeometry_bad;
    CC = R2 < R1 (IU);
    IF CC JUMP .Lgeometry_bad;
    R3 = R1 - R0 (NS);
    R1 = @COMMAND_BYTES@;
    CC = R3 == R1;
    IF !CC JUMP .Lgeometry_bad;
    R2 = R2 - R0 (NS);
    R3 = 4096;
    CC = R3 < R2 (IU);
    IF CC JUMP .Lgeometry_bad;
    P1 = R0;
    R2 = @POINTS@;
    R3 = 1;
.Lgeometry_types:
    R1 = B[P1 + 24] (Z);
    CC = R1 == R3;
    IF !CC JUMP .Lgeometry_bad;
    P1 += 32;
    R3 = 2;
    R2 += -1;
    CC = R2 == 0;
    IF !CC JUMP .Lgeometry_types;
    R1 = B[P1 + 24] (Z);
    R3 = 5;
    CC = R1 == R3;
    IF !CC JUMP .Lgeometry_bad;
    RTS;
.Lgeometry_bad:
    R0 = 0;
    RTS;
.size @PREFIX@_draw_geometry, .-@PREFIX@_draw_geometry

/* R0=node,R1=packed own palette,R2=fill enabled. Borrow same-SVG IDs.
 * Skip unchanged selectors. Fill0 remains disabled as in the stock setter.
 * Invalidate exactly once only if a selector actually changed. */
.type @PREFIX@_draw_paint, STT_FUNC
@PREFIX@_draw_paint:
    CC = R1 == 0;
    IF CC JUMP .Lpaint_skip;
    LINK 0;
    [--SP] = (R7:4, P5:3);
    SP += -12;
    R6 = R1;
    R7 = R2;
    CALL @PREFIX@_draw_path_node;
    CC = R0 == 0;
    IF CC JUMP .Lpaint_done;
    P5 = R0;
    R4 = 0;
    CC = R7 == 0;
    IF CC JUMP .Lpaint_stroke;
    R2 = W[P5 + 112] (Z);
    CC = R2 == 0;
    IF CC JUMP .Lpaint_stroke;
    R1 = R6;
    R1 <<= 16;
    R1 >>= 16;
    CC = R1 == R2;
    IF CC JUMP .Lpaint_stroke;
    P0 = 0x8d5f8abe;
    CALL (P0);
    R4 = 1;
.Lpaint_stroke:
    R1 = R6;
    R1 >>= 16;
    R2 = W[P5 + 114] (Z);
    CC = R1 == R2;
    IF CC JUMP .Lpaint_changed;
    R0 = P5;
    P0 = 0x8d5f8a9e;
    CALL (P0);
    R4 = 1;
.Lpaint_changed:
    CC = R4 == 0;
    IF CC JUMP .Lpaint_done;
    R0 = P5;
    P0 = 0x8d5f8afc;
    CALL (P0);
.Lpaint_done:
    SP += 12;
    (R7:4, P5:3) = [SP++];
    UNLINK;
.Lpaint_skip:
    RTS;
.size @PREFIX@_draw_paint, .-@PREFIX@_draw_paint

/* Apply one validated persistent path. Commit its backend cache only after
 * destination topology/ownership checks, coordinate copy and invalidation. */
.type @PREFIX@_screen_path, STT_FUNC
@PREFIX@_screen_path:
    R3 = @PATHS@;
    CC = R1 < R3 (IU);
    IF !CC JUMP .Lpath_apply_skip;
    LINK 0;
    [--SP] = (R7:4, P5:3);
    SP += -12;
    P4 = R2;
    R1 <<= 2;
    R0 = R0 + R1 (NS);
    P3 = R0;
    R4 = [P4];
    R1 = [P3 + @KEYS_AT@];
    CC = R4 == R1;
    IF CC JUMP .Lpath_apply_done;
    R0 = [P3 + @NODES_AT@];
    CALL @PREFIX@_draw_geometry;
    CC = R0 == 0;
    IF CC JUMP .Lpath_apply_done;
    R1 = [P3 + @GEOMETRY_AT@];
    CC = R0 == R1;
    IF !CC JUMP .Lpath_apply_done;
    R1 = P4;
    R1 += 4;
    CALL @PREFIX@_copy_points;
    R0 = [P3 + @NODES_AT@];
    P0 = 0x8d5f8afc;
    CALL (P0);
    [P3 + @KEYS_AT@] = R4;
.Lpath_apply_done:
    SP += 12;
    (R7:4, P5:3) = [SP++];
    UNLINK;
.Lpath_apply_skip:
    RTS;
.size @PREFIX@_screen_path, .-@PREFIX@_screen_path

/* R0=validated command begin, R1=@POINTS@ contiguous Q10 x/y pairs.
 * Only command coordinates are written; close, types and vector metadata stay intact. */
.global @PREFIX@_copy_points
.type @PREFIX@_copy_points, STT_FUNC
@PREFIX@_copy_points:
    P0 = R0;
    P1 = R1;
    R2 = @POINTS@;
.Lcopy_points_loop:
    R0 = [P1++];
    R1 = [P1++];
    [P0] = R0;
    [P0 + 4] = R1;
    P0 += 32;
    R2 += -1;
    CC = R2 == 0;
    IF !CC JUMP .Lcopy_points_loop;
    RTS;
.size @PREFIX@_copy_points, .-@PREFIX@_copy_points

/* SDK input acquisition and retained renderer. Animation state/math is entirely
 * in the compiled author callback. Every C++ call gets its 12-byte home area. */
.global @PREFIX@_screen_animate
.type @PREFIX@_screen_animate, STT_FUNC
@PREFIX@_screen_animate:
    LINK 0;
    [--SP] = (R7:4, P5:3);
    SP += -12;
    P5 = R0;
    R7 = R2;
    R0 = [P5 + 8];
    CC = R0 == 0;
    IF CC JUMP .Ldisplay_done;
    CC = R1 == 0;
    IF CC JUMP .Ldisplay_done;
    P0 = R1;
    R1 = [P0 + 4];
    R2 = [P0 + 8];
    CC = R1 == 0;
    IF CC JUMP .Ldisplay_done;
    CC = R2 < R1 (IU);
    IF CC JUMP .Ldisplay_done;
    R2 = R2 - R1 (NS);
    R3 = 16;
    CC = R2 < R3 (IU);
    IF CC JUMP .Ldisplay_done;
    R3 = R1;
    R3 <<= 30;
    CC = R3 == 0;
    IF !CC JUMP .Ldisplay_done;
    P0 = R1;
    P4.H = @PREFIX@_display_input;
    P4.L = @PREFIX@_display_input;
    R0 = [P0++];
    [P4] = R0;
    R0 = [P0++];
    [P4 + 4] = R0;
    R0 = [P0++];
    [P4 + 8] = R0;
    R0 = [P0];
    [P4 + 12] = R0;
    R0 = [P5 + @DELTA_AT@];
    [P4 + 16] = R0;
    [P4 + 20] = R7;
    R0 = 0;
    [P4 + 28] = R0;
    R2 = 8;
    CC = R7 < R2 (IU);
    IF !CC JUMP .Ldisplay_counter;
    R0 = R7;
    P0 = 0x8d4d75c0;
    CALL (P0);
.Ldisplay_counter:
    [P4 + 24] = R0;
    R0.H = @PREFIX@_display_state;
    R0.L = @PREFIX@_display_state;
    R1 = P4;
    R2.H = @PREFIX@_display_frame;
    R2.L = @PREFIX@_display_frame;
    CALL _@PREFIX@_display_render;
    R0.H = @PREFIX@_display_frame;
    R0.L = @PREFIX@_display_frame;
    CALL _@PREFIX@_display_validate;
    CC = R0 == 0;
    IF CC JUMP .Ldisplay_done;

    P4.H = @PREFIX@_display_frame;
    P4.L = @PREFIX@_display_frame;
    R6 = 0;
.Ldisplay_paths:
    R0 = P5;
    R1 = R6;
    R2 = P4;
    CALL @PREFIX@_screen_path;
    R0 = @PATH_BYTES@;
    R1 = P4;
    R0 = R0 + R1 (NS);
    P4 = R0;
    R6 += 1;
    R0 = @PATHS@;
    CC = R6 < R0;
    IF CC JUMP .Ldisplay_paths;
    /* P4 now begins the node commands (five words each). */
    P3 = P5;
    P3 += 60;
    P3 += 16;
    R6 = @NODES@;
.Ldisplay_nodes:
    R2 = [P4 + 16];
    CC = R2 == 0;
    IF CC JUMP .Ldisplay_transform;
    R2 += -1;
    R0 = [P4 + 12];
    R0 <<= 2;
    R1 = P5;
    R0 = R0 + R1 (NS);
    P0 = R0;
    R1 = [P0 + @PALETTE_AT@];
    R0 = [P3];
    CALL @PREFIX@_draw_paint;
.Ldisplay_transform:
    R0 = [P3++];
    R1 = [P4];
    R2 = [P4 + 4];
    R3 = [P4 + 8];
    CALL @PREFIX@_draw_apply_matrix;
    P4 += 20;
    R6 += -1;
    CC = R6 == 0;
    IF !CC JUMP .Ldisplay_nodes;
.Ldisplay_done:
    SP += 12;
    (R7:4, P5:3) = [SP++];
    UNLINK;
    RTS;
.size @PREFIX@_screen_animate, .-@PREFIX@_screen_animate

/* Private register ABI:R0=node,R1=xQ10,R2=yQ10,R3=positive Q10 scale.
 * Null nodes skip; invalid/singular scale skips. All calls use authored nodes.
 * Copy9matrixwords toSP+12..47, replace diagonal0/4 and translation6/7.
 * Preserve all callee saves; stock setter handles invalidation/no-change path. */
.global @PREFIX@_draw_apply_matrix
.type @PREFIX@_draw_apply_matrix, STT_FUNC
@PREFIX@_draw_apply_matrix:
    CC = R0 == 0;
    IF CC JUMP .Ldraw_apply_skip;
    CC = R3 <= 0;
    IF CC JUMP .Ldraw_apply_skip;
    LINK 0;
    [--SP] = (R7:4, P5:3);
    SP += -48;
    P5 = R0;
    R6 = R1;
    R7 = R2;
    R4 = R3;
    /* The other five matrix words are copied unchanged. Equal requested
     * diagonal/translation fields imply an entirely unchanged matrix. */
    R0 = [P5 + 4];
    CC = R0 == R4;
    IF !CC JUMP .Ldraw_matrix_changed;
    R0 = [P5 + 20];
    CC = R0 == R4;
    IF !CC JUMP .Ldraw_matrix_changed;
    R0 = [P5 + 28];
    CC = R0 == R6;
    IF !CC JUMP .Ldraw_matrix_changed;
    R0 = [P5 + 32];
    CC = R0 == R7;
    IF CC JUMP .Ldraw_apply_done;
.Ldraw_matrix_changed:
    P0 = P5;
    P0 += 4;
    P1 = SP;
    P1 += 12;
    R3 = 9;
.Ldraw_copy_matrix:
    R0 = [P0++];
    [P1++] = R0;
    R3 += -1;
    CC = R3 == 0;
    IF !CC JUMP .Ldraw_copy_matrix;
    [SP + 12] = R4;
    [SP + 28] = R4;
    [SP + 36] = R6;
    [SP + 40] = R7;
    R0 = P5;
    R1 = SP;
    R1 += 12;
    P0 = 0x8d5ee7de;
    CALL (P0);
.Ldraw_apply_done:
    SP += 48;
    (R7:4, P5:3) = [SP++];
    UNLINK;
.Ldraw_apply_skip:
    RTS;
.size @PREFIX@_draw_apply_matrix, .-@PREFIX@_draw_apply_matrix

.section .rodata
.align 4
.global @PREFIX@_screen_vtable
.type @PREFIX@_screen_vtable, STT_OBJECT
@PREFIX@_screen_vtable:
    .long @PREFIX@_screen_destroy
    .long @PREFIX@_screen_destroy
    .long 0x8d51f10c
    .long @PREFIX@_screen_frame
    .long @PREFIX@_screen_init
    .long 0x8c087324
.size @PREFIX@_screen_vtable, .-@PREFIX@_screen_vtable
.global @PREFIX@_screen_asset
@PREFIX@_screen_asset:
    .asciz "@NATIVE_NAME@.svg"
.align 4
@PREFIX@_draw_ids:
@DRAW_IDS@

.section .bss
.align 4
.global @PREFIX@_screen_state
.type @PREFIX@_screen_state, STT_OBJECT
@PREFIX@_screen_state:
    .space @OBJECT_BYTES@
.size @PREFIX@_screen_state, .-@PREFIX@_screen_state
