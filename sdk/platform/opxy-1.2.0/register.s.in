/* Checked engine registration; called only from startup, never from audio.
 * R0=supplied engine ID, R1=supplied screen ID. No IDs assigned here.
 * Result: 1 added/repopulated, 2 already owned; negative values reject:
 * -1 invalid IDs, -2 occupied record, -3 map not initialized,
 * -4 conflicting name map, -5 inconsistent state/postcondition failure.
 * Preserves R4..R7, P3..P5, FP/SP/RETS. May clobber other registers/status.
 * Assumes the stock registry and name map are initialized and used by one
 * thread. Stock calls may allocate, log or fail without rolling back.
 */
.section .text
.align 2
.global @PREFIX@_register_checked_draft
.type @PREFIX@_register_checked_draft, STT_FUNC
@PREFIX@_register_checked_draft:
    LINK 0;
    [--SP] = (R7:4, P5:3);
    SP += -24;
    R7 = R0;
    R6 = R1;
    R2 = @ENGINE_LIMIT@;
    CC = R0 < R2 (IU);
    IF !CC JUMP .Linvalid;
    CC = R1 < 1;
    IF CC JUMP .Linvalid;
    R2 = @PAGE_LIMIT@;
    CC = R1 < R2 (IU);
    IF !CC JUMP .Linvalid;

    R1 = 48;
    R0 *= R1;
    R1 = @ENGINE_RECORDS@;
    R0 = R0 + R1 (NS);
    P4 = R0;
    P0 = P4;
    P1 = 12;
    R5 = 0;
.Lempty_scan:
    R0 = [P0++];
    CC = R0 == 0;
    IF !CC JUMP .Lcheck_occupied;
    P1 += -1;
    CC = P1 == 0;
    IF !CC JUMP .Lempty_scan;
    JUMP .Llookup;
.Lcheck_occupied:
    CALL @PREFIX@_record_owned_draft;
    CC = R0 == 0;
    IF CC JUMP .Loccupied;
    R5 = 1;
.Llookup:
    P0 = 0x846e9f4c;
    P0 = [P0 + 4];
    CC = P0 == 0;
    IF CC JUMP .Lmap_unready;
    R0.H = @PREFIX@_lookup_key_draft;
    R0.L = @PREFIX@_lookup_key_draft;
    P1 = 0x8d506688;
    CALL (P1);
    CC = R0 == R7;
    IF CC JUMP .Lsame_mapping;
    R1 = 33;
    CC = R0 == R1;
    IF !CC JUMP .Lname_conflict;
    CC = R5 == 0;
    IF !CC JUMP .Linconsistent;
    JUMP .Lregister;
.Lsame_mapping:
    CC = R5 == 0;
    IF !CC JUMP .Lalready;
.Lregister:
    R0.H = @PREFIX@_parameter_name;
    R0.L = @PREFIX@_parameter_name;
    [SP + 12] = R0;
@FLAG_LOAD@
    [SP + 16] = R0;
    [SP + 20] = R6;
    R0 = R7;
    R1.H = @PREFIX@_name;
    R1.L = @PREFIX@_name;
    R2.H = @PREFIX@_factory;
    R2.L = @PREFIX@_factory;
    P1 = 0x8d505ecc;
    CALL (P1);
    /* Stock return is always zero, not a success result. */
    CALL @PREFIX@_record_owned_draft;
    CC = R0 == 0;
    IF CC JUMP .Linconsistent;
    R0.H = @PREFIX@_lookup_key_draft;
    R0.L = @PREFIX@_lookup_key_draft;
    P1 = 0x8d506688;
    CALL (P1);
    CC = R0 == R7;
    IF !CC JUMP .Linconsistent;
    R0 = 1;
    JUMP .Lreturn;
.Lalready:
    R0 = 2;
    JUMP .Lreturn;
.Linvalid:
    R0 = -1;
    JUMP .Lreturn;
.Loccupied:
    R0 = -2;
    JUMP .Lreturn;
.Lmap_unready:
    R0 = -3;
    JUMP .Lreturn;
.Lname_conflict:
    R0 = -4;
    JUMP .Lreturn;
.Linconsistent:
    R0 = -5;
.Lreturn:
    SP += 24;
    (R7:4, P5:3) = [SP++];
    UNLINK;
    RTS;
.size @PREFIX@_register_checked_draft, .-@PREFIX@_register_checked_draft

/* Internal leaf: exact full-record match, uses P4=record,R6=screen.
 * Does not dereference factory/callback pointers or touch name-map state.
 */
.global @PREFIX@_record_owned_draft
.type @PREFIX@_record_owned_draft, STT_FUNC
@PREFIX@_record_owned_draft:
    R0 = [P4];
    R1.H = @PREFIX@_factory;
    R1.L = @PREFIX@_factory;
    CC = R0 == R1;
    IF !CC JUMP .Lnot_owned;
    R0 = [P4 + 4];
    R1.H = @PREFIX@_parameter_name;
    R1.L = @PREFIX@_parameter_name;
    CC = R0 == R1;
    IF !CC JUMP .Lnot_owned;
    R0 = [P4 + 8];
@FLAG_CHECK@
    IF !CC JUMP .Lnot_owned;
    R0 = [P4 + 12];
    CC = R0 == R6;
    IF !CC JUMP .Lnot_owned;
@RECORD_NAME_MATCHES@
    R0 = 1;
    RTS;
.Lnot_owned:
    R0 = 0;
    RTS;
.size @PREFIX@_record_owned_draft, .-@PREFIX@_record_owned_draft

.section .rodata
.align 4
.type @PREFIX@_lookup_key_draft, STT_OBJECT
@PREFIX@_lookup_key_draft:
    .long 0
    .asciz "@NATIVE_NAME@"
    .space @INLINE_PADDING@
    .long @NAME_LENGTH@, 15
.size @PREFIX@_lookup_key_draft, .-@PREFIX@_lookup_key_draft
