/* Segment display renderer for OP-XY 1.2.0, sized by the machine's declared
 * display (@CHARACTERS@ characters). @OBJECT_BYTES@-byte renderer object: stock helper
 * 0..75, @BOUND_NODES@ path nodes from 76 (the segments, character-major in
 * abcdefghjklmnp order, then each glow layer's, then dials from @DIAL_NODES_AT@),
 * label text node @LABEL_AT@, packed lit/unlit style IDs @LIT_AT@/@UNLIT_AT@ then each
 * glow layer's pair from @GLOW_AT@, last painted key @LAST_AT@ (-1 none), one reserved
 * word. Segments, glow and label repaint only when the frame key changes; text
 * controls and dials are set every frame. */
.section .text
.align 2
.global @PREFIX@_screen_ctor
.type @PREFIX@_screen_ctor, STT_FUNC
@PREFIX@_screen_ctor:
    /* Range check only; the slot must also be empty or ours (below). */
    R2 = 1;
    CC = R1 < R2 (IU);
    IF CC JUMP .Lscreen_invalid_id;
    R2 = @PAGE_LIMIT@;
    CC = R1 < R2 (IU);
    IF !CC JUMP .Lscreen_invalid_id;
    LINK 0;
    [--SP] = (R7:4, P5:3);
    SP += -12;
    P5 = R0;
    R2.H = @PREFIX@_screen_asset;
    R2.L = @PREFIX@_screen_asset;
    P0 = 0x8d51fc7c;
    CALL (P0);
    R0.H = @PREFIX@_screen_vtable;
    R0.L = @PREFIX@_screen_vtable;
    [P5] = R0;
    R0 = P5;
    SP += 12;
    (R7:4, P5:3) = [SP++];
    UNLINK;
    RTS;
.Lscreen_invalid_id:
    R0 = 0;
    RTS;
.size @PREFIX@_screen_ctor, .-@PREFIX@_screen_ctor

.global @PREFIX@_screen_init
.type @PREFIX@_screen_init, STT_FUNC
@PREFIX@_screen_init:
    LINK 0;
    [--SP] = (R7:4, P5:3);
    SP += -12;
    P5 = R0;
    P0 = P5;
    P0 += 60;
    P0 += 16;
    R0 = 0;
    R2 = @ZERO_WORDS@;
.Lscreen_init_zero:
    [P0++] = R0;
    R2 += -1;
    CC = R2 == 0;
    IF !CC JUMP .Lscreen_init_zero;
    R0 = -1;
    [P5 + @LAST_AT@] = R0;
    R0 = [P5 + 8];
    CC = R0 == 0;
    IF CC JUMP .Lscreen_init_done;
    R0 = P5;
    R0 += 24;
    R1 = P5;
    R2 = 0;
    P0 = 0x8d520b3c;
    CALL (P0);
    /* Text controls show machine text in place of the stock percentage. */
@TEXT_LAYOUT@
    /* Optional nodes: a missing or foreign node stays 0 and is skipped. */
    P3.H = @PREFIX@_segment_ids;
    P3.L = @PREFIX@_segment_ids;
    P4 = P5;
    P4 += 60;
    P4 += 16;
    R6 = @BOUND_NODES@;
.Lscreen_init_segments:
    R0 = P5;
    R1 = [P3++];
    R2 = 1;
    P0 = 0x8d51f740;
    CALL (P0);
    CALL @PREFIX@_path_node;
    [P4++] = R0;
    R6 += -1;
    CC = R6 == 0;
    IF !CC JUMP .Lscreen_init_segments;
    R0 = P5;
    R1.H = @PREFIX@_label_id;
    R1.L = @PREFIX@_label_id;
    R2 = 1;
    P0 = 0x8d51f740;
    CALL (P0);
    CALL @PREFIX@_text_node;
    [P5 + @LABEL_AT@] = R0;
    R0 = P5;
    R1.H = @PREFIX@_lit_id;
    R1.L = @PREFIX@_lit_id;
    R2 = 1;
    P0 = 0x8d51f740;
    CALL (P0);
    R1 = [P5 + 8];
    CALL @PREFIX@_palette_ids;
    [P5 + @LIT_AT@] = R0;
    R0 = P5;
    R1.H = @PREFIX@_unlit_id;
    R1.L = @PREFIX@_unlit_id;
    R2 = 1;
    P0 = 0x8d51f740;
    CALL (P0);
    R1 = [P5 + 8];
    CALL @PREFIX@_palette_ids;
    [P5 + @UNLIT_AT@] = R0;
@GLOW_DONORS@
.Lscreen_init_done:
    SP += 12;
    (R7:4, P5:3) = [SP++];
    UNLINK;
    RTS;
.size @PREFIX@_screen_init, .-@PREFIX@_screen_init

.global @PREFIX@_screen_frame
.type @PREFIX@_screen_frame, STT_FUNC
@PREFIX@_screen_frame:
    LINK 0;
    [--SP] = (R7:4, P5:3);
    SP += -12;
    P5 = R0;
    R0 = [P5 + 8];
    CC = R0 == 0;
    IF CC JUMP .Lscreen_frame_done;
    /* All four value and title pointers must exist before generic update. */
    P0 = P5;
    P0 += 24;
    R2 = 8;
.Lscreen_binding_check:
    R0 = [P0++];
    CC = R0 == 0;
    IF CC JUMP .Lscreen_frame_done;
    R2 += -1;
    CC = R2 == 0;
    IF !CC JUMP .Lscreen_binding_check;
    P0 = 0x8d4d78cc;
    CALL (P0);
    R7 = R0;
    P0 = 0x8d4d7c60;
    CALL (P0);
    P4 = R0;
    R2 = R0;
    R1 = R7;
    R0 = P5;
    R0 += 24;
    P0 = 0x8d545ae4;
    CALL (P0);

    /* Copy the four controls from the bounded parameter vector and call the
     * machine's display. */
    R0 = P4;
    CC = R0 == 0;
    IF CC JUMP .Lscreen_draw;
    R0 = [P4 + 4];
    R1 = [P4 + 8];
    CC = R0 == 0;
    IF CC JUMP .Lscreen_draw;
    CC = R1 < R0 (IU);
    IF CC JUMP .Lscreen_draw;
    R1 = R1 - R0 (NS);
    R2 = 16;
    CC = R1 < R2 (IU);
    IF CC JUMP .Lscreen_draw;
    R1 = R0;
    R1 <<= 30;
    CC = R1 == 0;
    IF !CC JUMP .Lscreen_draw;
    P0 = R0;
    P1.H = @PREFIX@_display_input;
    P1.L = @PREFIX@_display_input;
    R0 = [P0++];
    [P1++] = R0;
    R0 = [P0++];
    [P1++] = R0;
    R0 = [P0++];
    [P1++] = R0;
    R0 = [P0];
    [P1] = R0;
    R0.H = @PREFIX@_display_input;
    R0.L = @PREFIX@_display_input;
    R1.H = @PREFIX@_display_frame;
    R1.L = @PREFIX@_display_frame;
    CALL _@PREFIX@_display_render;
    CC = R0 == 0;
    IF CC JUMP .Lscreen_draw;
    P0.H = @PREFIX@_display_frame;
    P0.L = @PREFIX@_display_frame;
    R6 = [P0 + @KEY_AT@];
@TEXT_UPDATE@
@DIAL_UPDATE@

    R0 = [P5 + @LAST_AT@];
    CC = R0 == R6;
    IF CC JUMP .Lscreen_draw;
    CALL @PREFIX@_paint_model;
    [P5 + @LAST_AT@] = R6;
.Lscreen_draw:
    R0 = P5;
    R1 = 0;
    P0 = 0x8d51f254;
    CALL (P0);
.Lscreen_frame_done:
    SP += 12;
    (R7:4, P5:3) = [SP++];
    UNLINK;
    RTS;
.size @PREFIX@_screen_frame, .-@PREFIX@_screen_frame

/* Internal: P5=self, R6=frame key (preserved). Paints the segments, then each
 * glow layer, from the frame masks, then sets the label text. Uses R4/R5/R7/P3/P4
 * (frame-saved). */
.type @PREFIX@_paint_model, STT_FUNC
@PREFIX@_paint_model:
    [--SP] = RETS;
    [--SP] = R6;
    SP += -12;
    P4 = P5;
    P4 += 60;
    P4 += 16;
    R6 = @LIT_AT@;
    CALL @PREFIX@_paint_layer;
@GLOW_PAINT@
    R0 = [P5 + @LABEL_AT@];
    CC = R0 == 0;
    IF CC JUMP .Lpaint_model_done;
    R1.H = @PREFIX@_display_frame;
    R1.L = @PREFIX@_display_frame;
    R1 += @LABEL_TEXT_AT@;
    P0 = 0x8d5ff080;
    CALL (P0);
.Lpaint_model_done:
    SP += 12;
    R6 = [SP++];
    RETS = [SP++];
    RTS;
.size @PREFIX@_paint_model, .-@PREFIX@_paint_model

/* Internal: P5=self, P4=the layer's first node (left after its last), R6=offset
 * of the layer's packed lit style, unlit 4 bytes later. One paint call per
 * segment. Uses R4/R5/R7/P3. */
.type @PREFIX@_paint_layer, STT_FUNC
@PREFIX@_paint_layer:
    [--SP] = RETS;
    SP += -12;
    P3.H = @PREFIX@_display_frame;
    P3.L = @PREFIX@_display_frame;
    R5 = @CHARACTERS@;
.Lpaint_digit:
    R7 = [P3++];
    R4 = 14;
.Lpaint_segment:
    P1 = R6;
    P0 = P5 + P1;
    R1 = [P0 + 4];
    CC = BITTST (R7, 15);
    IF !CC JUMP .Lpaint_selected;
    R1 = [P0];
.Lpaint_selected:
    R0 = [P4++];
    R2 = 1;
    CALL @PREFIX@_paint;
    R7 <<= 1;
    R4 += -1;
    CC = R4 == 0;
    IF !CC JUMP .Lpaint_segment;
    R5 += -1;
    CC = R5 == 0;
    IF !CC JUMP .Lpaint_digit;
    SP += 12;
    RETS = [SP++];
    RTS;
.size @PREFIX@_paint_layer, .-@PREFIX@_paint_layer

/* R0=dial path node or 0, R1/R2=Q10 cos/sin of a clockwise rotation; {0,0}
 * is the authored pose (identity). Replaces the node matrix's linear part (words 0, 1,
 * 3, 4 of nine: a, b, c, d) and keeps its translation; stock setter 0x8d5ee7de
 * applies and invalidates. Unchanged rotations skip. Preserves callee saves. */
.type @PREFIX@_dial, STT_FUNC
@PREFIX@_dial:
    CC = R0 == 0;
    IF CC JUMP .Ldial_skip;
    R3 = R1 | R2;
    CC = R3 == 0;
    IF !CC JUMP .Ldial_rotate;
    R1 = 1024;
.Ldial_rotate:
    LINK 0;
    [--SP] = (R7:4, P5:3);
    SP += -48;
    P5 = R0;
    R6 = R1;
    R7 = R2;
    R5 = -R7;
    R0 = [P5 + 4];
    CC = R0 == R6;
    IF !CC JUMP .Ldial_changed;
    R0 = [P5 + 8];
    CC = R0 == R7;
    IF !CC JUMP .Ldial_changed;
    R0 = [P5 + 16];
    CC = R0 == R5;
    IF !CC JUMP .Ldial_changed;
    R0 = [P5 + 20];
    CC = R0 == R6;
    IF CC JUMP .Ldial_done;
.Ldial_changed:
    P0 = P5;
    P0 += 4;
    P1 = SP;
    P1 += 12;
    R3 = 9;
.Ldial_copy:
    R0 = [P0++];
    [P1++] = R0;
    R3 += -1;
    CC = R3 == 0;
    IF !CC JUMP .Ldial_copy;
    [SP + 12] = R6;
    [SP + 16] = R7;
    [SP + 24] = R5;
    [SP + 28] = R6;
    R0 = P5;
    R1 = SP;
    R1 += 12;
    P0 = 0x8d5ee7de;
    CALL (P0);
.Ldial_done:
    SP += 48;
    (R7:4, P5:3) = [SP++];
    UNLINK;
.Ldial_skip:
    RTS;
.size @PREFIX@_dial, .-@PREFIX@_dial

.global @PREFIX@_screen_destroy
.type @PREFIX@_screen_destroy, STT_FUNC
@PREFIX@_screen_destroy:
    LINK 0;
    [--SP] = (R7:4, P5:3);
    SP += -12;
    P5 = R0;
    P0 = 0x8d51f1f0;
    CALL (P0);
    R0 = 0;
    [P5 + 16] = R0;
    P0 = P5;
    P0 += 60;
    P0 += 16;
    R2 = @ZERO_WORDS@;
.Lscreen_destroy_zero:
    [P0++] = R0;
    R2 += -1;
    CC = R2 == 0;
    IF !CC JUMP .Lscreen_destroy_zero;
    SP += 12;
    (R7:4, P5:3) = [SP++];
    UNLINK;
    RTS;
.size @PREFIX@_screen_destroy, .-@PREFIX@_screen_destroy

/* R0=node ->same pointer or0. Only source-bound path leaves accepted. */
.type @PREFIX@_path_node, STT_FUNC
@PREFIX@_path_node:
    CC = R0 == 0;
    IF CC JUMP .Lpath_bad;
    P0 = R0;
    R2 = [P0];
    R3 = 0x840c1a40;
    CC = R2 == R3;
    IF !CC JUMP .Lpath_bad;
    RTS;
.Lpath_bad:
    R0 = 0;
    RTS;
.size @PREFIX@_path_node, .-@PREFIX@_path_node

/* R0=node ->same pointer or0. Only stock text leaves (vtable 0x840c1ecc,
 * stored by text constructor 0x8d5fecb0) may reach setter 0x8d5ff080. */
.type @PREFIX@_text_node, STT_FUNC
@PREFIX@_text_node:
    CC = R0 == 0;
    IF CC JUMP .Ltext_bad;
    P0 = R0;
    R2 = [P0];
    R3 = 0x840c1ecc;
    CC = R2 == R3;
    IF !CC JUMP .Ltext_bad;
    RTS;
.Ltext_bad:
    R0 = 0;
    RTS;
.size @PREFIX@_text_node, .-@PREFIX@_text_node

/* R0=donor,R1=ownSVG ->packed positive fill/stroke IDs or0.
 * Vtable and both own renderer vector bounds checked before caching IDs.
 * Does not mutate palette records, node ownership or vector metadata. */
.type @PREFIX@_palette_ids, STT_FUNC
@PREFIX@_palette_ids:
    LINK 0;
    [--SP] = (R7:4, P5:3);
    SP += -12;
    P5 = R1;
    CALL @PREFIX@_path_node;
    CC = R0 == 0;
    IF CC JUMP .Lpalette_bad;
    P0 = R0;
    R4 = W[P0 + 112] (X);
    R5 = W[P0 + 114] (Z);
    CC = R4 <= 0;
    IF CC JUMP .Lpalette_bad;
    CC = R5 == 0;
    IF CC JUMP .Lpalette_bad;
    R0 = [P5 + 100];
    R1 = [P5 + 104];
    R2 = [P5 + 108];
    CC = R0 == 0;
    IF CC JUMP .Lpalette_bad;
    CC = R1 < R0 (IU);
    IF CC JUMP .Lpalette_bad;
    CC = R2 < R1 (IU);
    IF CC JUMP .Lpalette_bad;
    R1 = R1 - R0 (NS);
    R2 = R4;
    R2 <<= 2;
    CC = R1 < R2 (IU);
    IF CC JUMP .Lpalette_bad;
    R0 = [P5 + 132];
    R1 = [P5 + 136];
    R2 = [P5 + 140];
    CC = R0 == 0;
    IF CC JUMP .Lpalette_bad;
    CC = R1 < R0 (IU);
    IF CC JUMP .Lpalette_bad;
    CC = R2 < R1 (IU);
    IF CC JUMP .Lpalette_bad;
    R1 = R1 - R0 (NS);
    R2 = R5;
    R3 = 20;
    R2 *= R3;
    CC = R1 < R2 (IU);
    IF CC JUMP .Lpalette_bad;
    R5 <<= 16;
    R0 = R4 + R5 (NS);
    JUMP .Lpalette_done;
.Lpalette_bad:
    R0 = 0;
.Lpalette_done:
    SP += 12;
    (R7:4, P5:3) = [SP++];
    UNLINK;
    RTS;
.size @PREFIX@_palette_ids, .-@PREFIX@_palette_ids

/* R0=node,R1=packed own palette,R2=fill enabled. Borrow same-SVG IDs.
 * Skip unchanged selectors. Fill0 remains disabled as in the stock setter.
 * Invalidate exactly once only if a selector actually changed. */
.type @PREFIX@_paint, STT_FUNC
@PREFIX@_paint:
    CC = R1 == 0;
    IF CC JUMP .Lpaint_skip;
    LINK 0;
    [--SP] = (R7:4, P5:3);
    SP += -12;
    R6 = R1;
    R7 = R2;
    CALL @PREFIX@_path_node;
    CC = R0 == 0;
    IF CC JUMP .Lpaint_done;
    P5 = R0;
    R4 = 0;
    CC = R7 == 0;
    IF CC JUMP .Lpaint_stroke;
    R2 = W[P5 + 112] (Z);
    CC = R2 == 0;
    IF CC JUMP .Lpaint_stroke;
    R1 = R6;
    R1 <<= 16;
    R1 >>= 16;
    CC = R1 == R2;
    IF CC JUMP .Lpaint_stroke;
    P0 = 0x8d5f8abe;
    CALL (P0);
    R4 = 1;
.Lpaint_stroke:
    R1 = R6;
    R1 >>= 16;
    R2 = W[P5 + 114] (Z);
    CC = R1 == R2;
    IF CC JUMP .Lpaint_changed;
    R0 = P5;
    P0 = 0x8d5f8a9e;
    CALL (P0);
    R4 = 1;
.Lpaint_changed:
    CC = R4 == 0;
    IF CC JUMP .Lpaint_done;
    R0 = P5;
    P0 = 0x8d5f8afc;
    CALL (P0);
.Lpaint_done:
    SP += 12;
    (R7:4, P5:3) = [SP++];
    UNLINK;
.Lpaint_skip:
    RTS;
.size @PREFIX@_paint, .-@PREFIX@_paint

.section .rodata
.align 4
.global @PREFIX@_screen_vtable
.type @PREFIX@_screen_vtable, STT_OBJECT
@PREFIX@_screen_vtable:
    .long @PREFIX@_screen_destroy
    .long @PREFIX@_screen_destroy
    .long 0x8d51f10c
    .long @PREFIX@_screen_frame
    .long @PREFIX@_screen_init
    .long 0x8c087324
.size @PREFIX@_screen_vtable, .-@PREFIX@_screen_vtable
.global @PREFIX@_screen_asset
@PREFIX@_screen_asset:
    .asciz "@NATIVE_NAME@.svg"
@PREFIX@_label_id:
    .asciz "@PREFIX@_label"
@PREFIX@_lit_id:
    .asciz "@PREFIX@_lit"
@PREFIX@_unlit_id:
    .asciz "@PREFIX@_unlit"
@GLOW_IDS@

/* Bound node IDs (segments, glow layers, dials), then each text control's value layout. */
.section .rodata
.align 4
.global @PREFIX@_segment_ids
@PREFIX@_segment_ids:
@SEGMENT_IDS@
.align 4
@TEXT_MATRICES@

.section .bss
.align 4
.global @PREFIX@_screen_state
.type @PREFIX@_screen_state, STT_OBJECT
@PREFIX@_screen_state:
    .space @OBJECT_BYTES@
.size @PREFIX@_screen_state, .-@PREFIX@_screen_state

.align 4
@PREFIX@_display_input:
    .space 16
@PREFIX@_display_frame:
    .space @FRAME_BYTES@
