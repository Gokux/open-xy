// Generated for one collection: its synths that list alternate parameters.
#include "synth_controls.hpp"
extern "C" {
@READY_DECLS@
}
using opxy::platform::SynthControls;

const SynthControls sdk_synth_controls[] = {
@MACHINES@
    {0, nullptr, {0, 1, 2, 3, 4, 5, 6, 7}}
};
