/* SDK-generated startup for the curated engines of one target, in ledger
 * order. Stock jump-frame continuations preserved; every engine keeps its own
 * checked registration, page guard and readiness-gated catalog adapter.
 * The first engine's catalog adapter delegates every other name to stock.
 * Send effects register on both roles, like stock FX initialisation. */
.section .text
.align 2
.global extensions_synth_exit
.type extensions_synth_exit, STT_FUNC
extensions_synth_exit:
    SP += -12;
@FX_REGISTRATIONS@
    P0 = 0x8d5c200c;
    CALL (P0);
    CC = R0 == 0;
    IF !CC JUMP .Lsynth_done;
@SYNTH_REGISTRATIONS@
.Lsynth_done:
    SP += 12;
    R0 = 0;
    SP += 24;
    (R7:7, P5:3) = [SP++];
    UNLINK;
    RTS;
.size extensions_synth_exit, .-extensions_synth_exit

.global extensions_screen_exit
.type extensions_screen_exit, STT_FUNC
extensions_screen_exit:
    SP += -12;
@SCREEN_REGISTRATIONS@
.Lscreen_done:
    SP += 12;
    R0 = 0;
    UNLINK;
    RTS;
.size extensions_screen_exit, .-extensions_screen_exit

/* Ordinary CALL target with the stock catalog insertion ABI. Own names are
 * routed to their machine's readiness-gated adapter; every other name reaches
 * the stock inserter unchanged through the first adapter's delegation path. */
.global extensions_catalog_checked
.type extensions_catalog_checked, STT_FUNC
extensions_catalog_checked:
    LINK 0;
    [--SP] = (R7:4, P5:3);
    SP += -12;
    R4 = R0;
    R5 = R1;
    R6 = R2;
@CATALOG_ROUTES@
.size extensions_catalog_checked, .-extensions_catalog_checked
