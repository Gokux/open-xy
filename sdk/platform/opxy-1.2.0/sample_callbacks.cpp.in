// Generated for one collection: its sample machines as one table, and the
// stock-page bridge to their callbacks. Authored callbacks only see SDK values.
#include "sample_machines.hpp"
#include "stock_sample.hpp"
#include "sample_cache.hpp"
#include "stock.hpp"
#include <opxy/audio_tempo.hpp>
extern "C" {
@CALLBACK_DECLS@
opxy::u32 sdk_sample_selected_engine() __asm__("sdk_sample_selected_engine");
opxy::u32 sdk_sample_edit(void*, opxy::u32, opxy::i32, opxy::u32) __asm__("sdk_sample_edit");
const opxy::SamplePanel* sdk_sample_drum_view(const void*, void*, const opxy::i32*) __asm__("sdk_sample_drum_view");
opxy::u32 sdk_sample_assignment(opxy::u32, opxy::u32, opxy::u32, const opxy::u32*, opxy::u32)
    __asm__("sdk_sample_assignment");
}
using opxy::u32;
using opxy::i32;
using opxy::platform::SampleMachine;

const SampleMachine sdk_sample_machines[] = {
@MACHINES@
    {0, 0, nullptr, nullptr, nullptr, nullptr, nullptr, 0, nullptr, nullptr, nullptr, nullptr}
};
// The terminating entry keeps the array nonempty for a collection without sample machines.
const u32 sdk_sample_machine_count = sizeof(sdk_sample_machines) / sizeof(sdk_sample_machines[0]) - 1;

namespace {
// The drum-controls machine owning engine, or null.
const SampleMachine* drum_machine(u32 engine) {
    const SampleMachine* m = sdk_sample_machine(engine);
    return m && m->control ? m : nullptr;
}
u32 settings(const SampleMachine* m, const void* raw) {
    const opxy::SampleSettings saved = opxy::platform::pad_settings(raw);
    if (saved.initialized) return saved.value;
    const opxy::SampleRegion region = opxy::platform::sample_gui_region(raw);
    return m->migrate(&region);
}
u32 track_engine(u32 track) {
    return track < opxy::platform::kTracks ? opxy::platform::track_engine(track) : opxy::platform::kNoEngine;
}
opxy::Transport clock() {
    return opxy::Transport{opxy::audio_bpm_x10(opxy::platform::word(opxy::platform::kAudioBpm)), 0, false};
}
// GUI-only display scratch. Stock paints a copy, never a mutated saved region.
opxy::SamplePanel current_panel;
static_assert(sizeof(opxy::SamplePanel) == 40 && __builtin_offsetof(opxy::SamplePanel, shifted) == 8,
              "Stock-page panel binding differs from SDK layout");
}
extern "C" u32 sdk_sample_edit(void* raw, u32 index, i32 direction, u32 engine) {
    if (!raw || index >= 16) return 0;
    const SampleMachine* m = drum_machine(engine);
    if (!m) return 0;
    if (index == 0 || index == 8) {
        const i32 cents = 6000 - opxy::platform::sample_gui_region(raw).root_cents;
        const i32 delta = direction < 0 ? -10 : direction > 0 ? 10 : 0;
        opxy::platform::sample_gui_pitch(raw, index == 8 ? 0 : cents + delta);
        return 1;
    }
    u32 value = settings(m, raw);
    const opxy::SampleControl event{index & 3, direction, (index & 8) != 0, (index & 4) != 0};
    m->control(&value, &event);
    opxy::platform::store_pad_settings(raw, value);
    return 1;
}
extern "C" const opxy::SamplePanel* sdk_sample_drum_view(const void* raw, void* shadow, const i32* parameters) {
    const SampleMachine* m = drum_machine(sdk_sample_selected_engine());
    current_panel = opxy::SamplePanel{};
    if (!raw || !shadow || !m) return nullptr;
    m->panel(settings(m, raw), parameters, &current_panel);
    // Saved pad pitch is at most an octave either way, as the voice plays it.
    const i32 saved = 6000 - opxy::platform::sample_gui_region(raw).root_cents;
    current_panel.pitch_cents += saved < -1200 ? -1200 : saved > 1200 ? 1200 : saved;
    current_panel.shifted[0][15] = current_panel.shifted[1][15] = 0;
    for (u32 i = 0; i < 8; ++i) static_cast<u32*>(shadow)[i] = static_cast<const u32*>(raw)[i];
    using namespace opxy::platform::pad_record;
    unsigned char* bytes = static_cast<unsigned char*>(shadow);
    i32 cents = current_panel.pitch_cents;
    if (cents < -2400) cents = -2400;
    if (cents > 2400) cents = 2400;
    // The drum painter adds signed fine cents to (root - 60) * 100.
    // This display copy differs from the sampler's inverse tuning metadata.
    const i32 root = 60 + (cents + 2400) / 100 - 24;
    bytes[kRoot] = static_cast<unsigned char>(root);
    bytes[kFine] = static_cast<unsigned char>(cents - (root - 60) * 100);
    bytes[kMode] = static_cast<unsigned char>((bytes[kMode] & ~kModeBits) | (current_panel.repeat ? 3u : 1u));
    static_cast<u32*>(shadow)[kFade] = 0;
    return &current_panel;
}
extern "C" u32 sdk_sample_assignment(u32 track, u32 frames, u32 rate, const u32* path, u32 previous) {
    opxy::SampleAssignment input{nullptr, 0, frames > 882000 ? 882000 : frames, rate, clock(),
                                 opxy::platform::sample_settings(previous)};
    if (path && path[5] && path[5] <= 1024 && path[5] <= path[6]) {
        input.filename = path[6] < 16 ? reinterpret_cast<const char*>(path + 1) : reinterpret_cast<const char*>(path[1]);
        input.filename_bytes = path[5];
    }
    const SampleMachine* m = drum_machine(track_engine(track));
    return opxy::platform::sample_store_settings(m ? m->assign(&input) : 0);
}
// Sample analysis: the collection's first registered analysis machine, or
// declined when there is none.
namespace {
const SampleMachine* analysis_machine() {
    for (u32 i = 0; i < sdk_sample_machine_count; ++i)
        if (sdk_sample_machines[i].analysis_budget && sdk_sample_machines[i].ready() == 1) return &sdk_sample_machines[i];
    return nullptr;
}
}
extern "C" u32 sdk_sample_prepare_begin(const opxy::SampleView* sample, u32* storage, u32 words) {
    const SampleMachine* m = analysis_machine();
    return m ? m->prepare_begin(sample, storage, words) : 0;
}
extern "C" u32 sdk_sample_prepare_step(u32 frames, u32* cursor) {
    const SampleMachine* m = analysis_machine();
    return m ? m->prepare_step(frames, cursor) : opxy::prepare_failed;
}
extern "C" u32 sdk_sample_prepare_words() {
    const SampleMachine* m = analysis_machine();
    return m ? m->prepare_words() : 0;
}
extern "C" u32 sdk_sample_prepare_budget() {
    const SampleMachine* m = analysis_machine();
    return m ? m->analysis_budget : 0;
}
extern "C" u32 sdk_sample_prepare_result(opxy::SampleAnalysis* out) {
    const SampleMachine* m = analysis_machine();
    return m ? m->prepare_result(out) : 0;
}
